# ---- Server ----
PORT=5000
NODE_ENV=development
MONGODB_URI='mongodb+srv://earthpradosh:TbSO5iW0LSoEgxu1@cluster0.okrttmy.mongodb.net/portfolio'
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# ---- Frontend origin (CORS) ----
FRONTEND_URL=http://localhost:5173

# ---- Public URLs ----
# PUBLIC_URL: where THIS API is reachable (used for local upload links). Defaults to http://localhost:$PORT.
PUBLIC_URL=http://localhost:5000
# SITE_URL: the deployed site origin, used for <loc> entries in /sitemap.xml. Defaults to FRONTEND_URL.
SITE_URL=http://localhost:5173

# ---- Seed admin (used once by npm run seed) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Pradosh Mukherjee

# ---- Razorpay ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- SMTP / Email ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Pradosh Mukherjee <no-reply@example.com>"
ADMIN_NOTIFY_EMAIL=admin@example.com

# ---- Cloudinary (optional image storage) ----
# If unset, uploaded images are stored on local disk under server/uploads and
# served from PUBLIC_URL/uploads. Set all three (+ optional folder) to use Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=portfolio

# ---- Client (Vite) — put these in client/.env ----
# VITE_API_URL=http://localhost:5000/api
# VITE_RAZORPAY_KEY_ID=
